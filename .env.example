# Stark Bank sandbox credentials
STARKBANK_ENVIRONMENT=sandbox
STARKBANK_PROJECT_ID=your-project-id
# Path to the ECDSA private key PEM file (generate with scripts/generate_keys.py)
STARKBANK_PRIVATE_KEY_PATH=private-key.pem

# PostgreSQL for processed-event dedup (docker compose up -d db).
# If unset, an in-memory store is used (fine for tests; external_id on the
# Transfer still guarantees no double payout).
DATABASE_URL=postgresql://stark:stark@localhost:5432/starkbank
